<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="bpPrincipal" onKeyPressed="#manejarTeclado" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uam.pae.evaluacion2fx.VentanaPrincipalController">
    <top>
        <VBox prefWidth="100.0" BorderPane.alignment="CENTER">
            <children>
                <!-- MENUBAR -->
                <MenuBar>
                    <menus>
                        <Menu mnemonicParsing="false" text="Sistema">
                            <items>
                                <MenuItem fx:id="miSalir" mnemonicParsing="false" onAction="#salirAplicacion" text="Salir" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Clientes">
                            <items>
                                <MenuItem fx:id="miRegistrar" mnemonicParsing="false" onAction="#abrirVentanaRegistro" text="Registrar Cliente..." />
                                <SeparatorMenuItem mnemonicParsing="false" />
                                <MenuItem fx:id="miConsultar" mnemonicParsing="false" onAction="#abrirVentanaConsulta" text="Consultar Directorio" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Ayuda">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#mostrarAcercaDe" text="Acerca de..." />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>

                <!-- TOOLBAR -->
                <ToolBar prefHeight="40.0" prefWidth="200.0">
                    <items>
                        <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#abrirVentanaRegistro" text="📝 Nuevo Registro" />
                        <Button fx:id="btnConsultar" mnemonicParsing="false" onAction="#abrirVentanaConsulta" text="🔍 Buscar Clientes" />
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>

    <center>
        <!-- ESPACIO DE TRABAJO CON CONTEXT MENU -->
        <Label text="Bienvenido al Sistema de Gestión" textFill="#5b5b5b" BorderPane.alignment="CENTER">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
            <contextMenu>
                <ContextMenu fx:id="cmOpciones">
                    <items>
                        <MenuItem fx:id="miContextAcercaDe" mnemonicParsing="false" onAction="#mostrarAcercaDe" text="Información del Sistema" />
                    </items>
                </ContextMenu>
            </contextMenu>
        </Label>
    </center>
</BorderPane>