<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uam.pae.evaluacion2fx.Controllers.ConsultaClientesController">
   <children>
      <VBox alignment="CENTER" layoutX="15.0" layoutY="14.0" prefHeight="370.0" prefWidth="771.0" spacing="15.0">
         <children>
            <Label text="Consulta de Clientes">
               <font>
                  <Font name="Times New Roman Bold" size="30.0" />
               </font></Label>
            <Label text="Seleccione un cliente para ver su información">
               <font>
                  <Font name="Times New Roman Italic" size="18.0" />
               </font>
            </Label>
            <Separator prefWidth="200.0" />
            <TableView fx:id="tblConsulta" prefHeight="310.0" prefWidth="650.0">
              <columns>
                <TableColumn fx:id="colNombreCliente" prefWidth="75.0" text="Nombre Completo" />
                <TableColumn fx:id="colTipoCliente" prefWidth="75.0" text="Tipo de Cliente" />
                  <TableColumn fx:id="colCiudadCliente" prefWidth="112.0" text="Ciudad" />
                  <TableColumn fx:id="colFechaNac" prefWidth="144.00003051757812" text="Fecha de Nacimiento" />
                  <TableColumn fx:id="colTipoSol" prefWidth="75.0" text="Tipo de Solicitud" />
                  <TableColumn fx:id="colInteresCliente" prefWidth="75.0" text="Servicio de Interés" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>
